{
  "name": "dsh-billing-meter",
  "version": "0.1.0",
  "private": true,
  "description": "在 DSH Web 输入框下方显示当前会话的人民币计费，按 DeepSeek 官方峰谷时段与价目表估算。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "docs/screenshot-composer.png",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "billing",
    "cost",
    "cny",
    "peak-off-peak"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/policy.test.mjs test/bundle.test.mjs test/external-vectors.test.mjs"
  },
  "license": "MIT"
}
